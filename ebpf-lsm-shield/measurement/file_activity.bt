#!/usr/bin/env bpftrace
BEGIN { printf("READY\n"); }
tracepoint:syscalls:sys_enter_openat { @pending[tid] = str(args->filename); }
tracepoint:syscalls:sys_enter_openat2 { @pending2[tid] = str(args->filename); }
tracepoint:syscalls:sys_exit_openat /@pending[tid] != "" && args->ret >= 0/ { @fdpath[pid, args->ret] = @pending[tid]; printf("EV\t%llu\t%d\t%s\tO\t%d\t%s\n", nsecs, pid, comm, args->ret, @pending[tid]); delete(@pending[tid]); }
tracepoint:syscalls:sys_exit_openat2 /@pending2[tid] != "" && args->ret >= 0/ { @fdpath[pid, args->ret] = @pending2[tid]; printf("EV\t%llu\t%d\t%s\tO\t%d\t%s\n", nsecs, pid, comm, args->ret, @pending2[tid]); delete(@pending2[tid]); }
tracepoint:syscalls:sys_exit_openat /@pending[tid] != "" && args->ret < 0/ { delete(@pending[tid]); }
tracepoint:syscalls:sys_exit_openat2 /@pending2[tid] != "" && args->ret < 0/ { delete(@pending2[tid]); }
