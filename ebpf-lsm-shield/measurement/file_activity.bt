tracepoint:syscalls:sys_enter_rename { @rename_old[tid] = str(args->oldname); @rename_new[tid] = str(args->newname); }
tracepoint:syscalls:sys_enter_renameat { @rename_old[tid] = str(args->oldname); @rename_new[tid] = str(args->newname); }
