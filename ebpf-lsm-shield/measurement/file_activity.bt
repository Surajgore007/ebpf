tracepoint:syscalls:sys_exit_truncate /@truncatepending[tid] == 1 && args->ret == 0/ { printf("EV\t%llu\t%d\t%s\tS\t%d\t1\n", nsecs, pid, comm, tid); delete(@truncatepending[tid]); }
