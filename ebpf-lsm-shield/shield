    now = time.strftime("%Y-%m-%d %H:%M:%S %Z")
    ratio = f["ratio"] if f["ratio"] is not None else 0.0
    wmf = f["writes"] / f["modified"] if f["modified"] else 0.0
    write_open = f["writes"] / f["opens"] if f["opens"] else 0.0
    transition = f"{previous}  →  {state}" if previous and previous != state else f"{state} (updated)"

    pids_sorted = sorted(f["contributing_pids"] or f["all_pids"])
    if len(pids_sorted) == 1:
        pid = pids_sorted[0]
