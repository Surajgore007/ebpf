#!/usr/bin/env python3
import json, os, signal, subprocess, sys, time
from collections import defaultdict
from pathlib import PurePosixPath
from pathlib import Path
from measurement.file_identity import resolve_path
from measurement.decoys import DecoyManager
from measurement.entropy import (
    SAMPLE_SIZE,
    compute_entropy_ratio,
    is_lab_path,
    sample_file_prefix,
    shannon_entropy_fixed,
)

ROOT = Path(__file__).resolve().parent
CONFIG = json.loads((ROOT / "config" / "detector.json").read_text())
WINDOW_NS = int(CONFIG["window_seconds"] * 1_000_000_000)
USE_COLOR = sys.stdout.isatty() or os.environ.get("SHIELD_COLOR") == "1"
RESET = "\033[0m" if USE_COLOR else ""
DIM = "\033[2m" if USE_COLOR else ""
CYAN = "\033[96m" if USE_COLOR else ""
BLUE = "\033[94m" if USE_COLOR else ""
GREEN = "\033[92m" if USE_COLOR else ""
YELLOW = "\033[93m" if USE_COLOR else ""
RED = "\033[91m" if USE_COLOR else ""
WHITE = "\033[97m" if USE_COLOR else ""
CLEAR = "\033[2J\033[H" if USE_COLOR else ""


def path_value(value):
    if not value or value == "-":
        return None
    return os.path.normpath(value.replace("\\t", " ").replace("\\n", " "))


def ext(path):
    suffix = PurePosixPath(path).suffix.lower()
    return suffix or "[no-extension]"


def parent(path):
    p = PurePosixPath(path).parent
    return str(p) if str(p) else "."


def identity_key(path, identity):
    if identity is not None:
        return identity.key()
    return f"path:{path}"


def new_file_window(file_key, path, identity=None):
    return {
        "file_key": file_key,
        "identity": identity,
        "path": path,
        "paths": {path} if path else set(),
        "pids": set(),
        "comm_by_pid": {},
        "opens": 0,
        "reads": 0,
        "writes": 0,
        "bytes_read": 0,
        "bytes_written": 0,
        "renames": 0,
        "deletes": 0,
        "truncates": 0,
        "ftruncates": 0,
        "fallocates": 0,
        "read_entropy_samples": [],
        "write_entropy_samples": [],
        "is_fallback": identity is None,
        "is_decoy": False,
        "decoy_touched": False,
        "decoy_operations": 0,
    }


def get_file_window(window_files, file_key, path, identity, decoy_mgr=None):
    if file_key not in window_files:
        window_files[file_key] = new_file_window(file_key, path, identity)
    fw = window_files[file_key]
    if path:
        fw["path"] = path
        fw["paths"].add(path)
    if identity is not None and fw["identity"] is None:
        fw["identity"] = identity
        fw["is_fallback"] = False
    if decoy_mgr and not fw["is_decoy"]:
        if decoy_mgr.is_decoy(fkey=file_key, path=path):
            fw["is_decoy"] = True
    return fw


def sample_fw_prefix(fw, path, max_len=SAMPLE_SIZE):
    if path and is_lab_path(path):
        buf = sample_file_prefix(path, max_len)
        if buf:
            return buf
    curr = fw.get("path")
    if curr and curr != path and is_lab_path(curr):
        buf = sample_file_prefix(curr, max_len)
        if buf:
            return buf
    for p in fw.get("paths", ()):
        if p and p != path and p != curr and is_lab_path(p):
            buf = sample_file_prefix(p, max_len)
            if buf:
                return buf
    return None


def score_window(file_dict):
    p = CONFIG["prototype_parameters"]
    b = CONFIG["baseline_reference"]
    files = list(file_dict.values())

    files_opened = [f for f in files if f["opens"] > 0]
    files_written = [f for f in files if f["writes"] > 0]
    files_modified = [f for f in files if f["writes"] > 0 or f["truncates"] > 0 or f["ftruncates"] > 0 or f["fallocates"] > 0]
    files_renamed = [f for f in files if f["renames"] > 0]
    files_deleted = [f for f in files if f["deletes"] > 0]

    modified = len(files_modified)
    wr = sum(f["writes"] for f in files)
    renames = sum(f["renames"] for f in files)
    deletes = sum(f["deletes"] for f in files)
    opens = sum(f["opens"] for f in files)
    bytes_written = sum(f["bytes_written"] for f in files)
    truncates = sum(f["truncates"] for f in files)
    ftruncates = sum(f["ftruncates"] for f in files)
    fallocates = sum(f["fallocates"] for f in files)

    mps = modified / CONFIG["window_seconds"]
    wps = wr / CONFIG["window_seconds"]
    ratio = renames / wr if wr else None

    modified_paths = {f["path"] for f in files_modified if f["path"]}
    types = len({ext(x) for x in modified_paths})
    dirs = len({parent(x) for x in modified_paths})

    # First-class Multi-Process Tracking
    process_counts = [len(f["pids"]) for f in files]
    max_pids_per_file = max(process_counts) if process_counts else 0
    mean_pids_per_file = (sum(process_counts) / len(process_counts)) if process_counts else 0.0
    multi_proc_files = [f for f in files if len(f["pids"]) > 1]
    multi_proc_count = len(multi_proc_files)

    all_pids = set.union(*(f["pids"] for f in files)) if files else set()
    contributing_pids = set.union(*(f["pids"] for f in files_modified)) if files_modified else all_pids
    comm_map = {}
    for f in files:
        for pid, comm in f["comm_by_pid"].items():
            comm_map[pid] = comm

    indicators = []
    broad = modified >= p["broad_modified_minimum"]
    high_write = wps >= b["writes_per_second_p95_high_activity"] * p["high_write_fraction_of_reference"]
    rapid_rename = renames >= p["rename_minimum"]
    transform_ratio = ratio is not None and ratio >= p["rename_write_ratio_minimum"]
    type_breadth = types >= p["type_diversity_minimum"]
    multi_process_signal = multi_proc_count > 0 or (len(all_pids) > 1 and broad)

    if broad:
        indicators.append("broad file coverage")
    if high_write:
        indicators.append("high write rate")
    if rapid_rename:
        indicators.append("rapid rename activity")
    if transform_ratio:
        indicators.append("rename/write transformation relationship")
    if type_breadth:
        indicators.append("broad file-type coverage")
    if multi_process_signal:
        indicators.append("multi-process coordination")

    all_read_entropy = [s for f in files for s in f.get("read_entropy_samples", [])]
    all_write_entropy = [s for f in files for s in f.get("write_entropy_samples", [])]
    mean_read_entropy = (sum(all_read_entropy) / len(all_read_entropy)) if all_read_entropy else None
    mean_write_entropy = (sum(all_write_entropy) / len(all_write_entropy)) if all_write_entropy else None
    entropy_ratio = (
        compute_entropy_ratio(int(mean_read_entropy), int(mean_write_entropy))
        if (mean_read_entropy is not None and mean_write_entropy is not None and mean_write_entropy > 0)
        else None
    )

    # Phase 4 Decoy / Canary Tracking
    decoy_touched_files = [f for f in files if f.get("is_decoy") and f.get("decoy_touched")]
    decoy_touch_count = len(decoy_touched_files)
    decoy_operations = sum(f.get("decoy_operations", 0) for f in files)
    compromised_names = sorted(list({Path(f["path"]).name for f in decoy_touched_files if f.get("path")}))

    if decoy_touch_count > 0:
        indicators.append("canary decoy file compromise")

    transformation = rapid_rename and transform_ratio
    return {
        "modified": modified,
        "writes": wr,
        "opens": opens,
        "renames": renames,
        "deletes": deletes,
        "bytes_written": bytes_written,
        "truncates": truncates,
        "ftruncates": ftruncates,
        "fallocates": fallocates,
        "unique_opened": len(files_opened),
        "unique_written": len(files_written),
        "wps": wps,
        "mps": mps,
        "ratio": ratio,
        "types": types,
        "dirs": dirs,
        "mean_read_entropy": mean_read_entropy,
        "mean_write_entropy": mean_write_entropy,
        "entropy_ratio": entropy_ratio,
        "max_pids_per_file": max_pids_per_file,
        "mean_pids_per_file": mean_pids_per_file,
        "multi_proc_count": multi_proc_count,
        "all_pids": all_pids,
        "contributing_pids": contributing_pids,
        "comm_map": comm_map,
        "indicators": indicators,
        "broad": broad,
        "transformation": transformation,
        "multi_process_signal": multi_process_signal,
        "decoy_touch_count": decoy_touch_count,
        "decoy_operations": decoy_operations,
        "compromised_names": compromised_names,
        "total_files": len(files),
    }


def classify(f, streak):
    # Phase 4: Canary / Decoy Honeypot tripwire escalation
    if f.get("decoy_touch_count", 0) > 0:
        return "HIGH RISK"
    p = CONFIG["prototype_parameters"]
    combined = f["broad"] and f["transformation"]
    if combined and streak >= CONFIG["confirmation_windows"]:
        return "HIGH RISK"
    if combined or (f["broad"] and len(f["indicators"]) >= p["suspicious_indicator_minimum"]):
        return "SUSPICIOUS"
    return "LOW / BENIGN"


def styled_state(state):
    color = RED if state == "HIGH RISK" else YELLOW if state == "SUSPICIOUS" else GREEN
    return f"{color}{state}{RESET}"


def line(text="", width=78):
    print(f"{CYAN}│{RESET} {text:<{width-3}}{CYAN}│{RESET}")


