    print(f"{CYAN}└──────────────────────────────────────────────────────────────────────────────┘{RESET}")
    sys.stdout.flush()


def main():
    bt = ROOT / "measurement" / "file_activity.bt"
    proc = subprocess.Popen(["stdbuf", "-o0", "-e0", "bpftrace", str(bt)],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)

    import threading
    def _drain_stderr():
        try:
            for _ in proc.stderr:
                pass
        except Exception:
            pass
    threading.Thread(target=_drain_stderr, daemon=True).start()

    decoy_mgr = DecoyManager(str(ROOT / "config" / "detector.json"))
    decoy_mgr.deploy()

    # File-centric window grouping: windows[index][file_key] -> FileWindow dict
    windows = defaultdict(dict)
    streak = 0
    previous_state = None
    first = None
    ready = False
    fd_identities = {}
    path_identities = {}
    known_file_entropy = {}
    pending_operations = {}
    my_pid = os.getpid()

    def handle(line_text):
        nonlocal first, ready, streak, previous_state
        line_text = line_text.rstrip("\r\n")
        if line_text == "READY":
            ready = True
            return
        fields = line_text.split("\t")
        if not fields:
            return
        if fields[0] == "TICK":
            now = int(fields[1])
            if first is None:
                first = now - WINDOW_NS
            for idx in sorted(list(windows.keys())):
                if idx < (now - first) // WINDOW_NS:
                    file_dict = windows.pop(idx)
                    # Filter out self
                    for f in list(file_dict.values()):
                        f["pids"].discard(my_pid)
                    active_files = {k: f for k, f in file_dict.items() if f["pids"] or f["writes"] > 0 or f["opens"] > 0}
                    if not active_files:
                        continue
                    f = score_window(active_files)
                    if f["broad"] and f["transformation"]:
                        streak += 1
                    else:
                        streak = 0
                    state = classify(f, streak)
                    show_window(f, streak, previous_state, state, len(decoy_mgr.deployed_files))
                    previous_state = state
            return

        if fields[0] != "EV" or len(fields) < 6:
            return
        ts = int(fields[1]); pid = int(fields[2]); comm = fields[3]; kind = fields[4]
        if comm == "bpftrace" or pid == my_pid:
            return
        if first is None:
            first = (ts // WINDOW_NS) * WINDOW_NS
        idx = (ts - first) // WINDOW_NS

        if kind == "P" and len(fields) >= 9:
            pending_tid = int(fields[5])
            if len(pending_operations) >= 4096:
                pending_operations.pop(next(iter(pending_operations)))
            pending_operations[(pid, pending_tid)] = (
                fields[6], int(fields[7]), path_value("\t".join(fields[8:])))
            return

        if kind == "S" and len(fields) >= 7:
            pending_tid = int(fields[5])
            pending = pending_operations.pop((pid, pending_tid), None)
            if pending is None:
                return
            subtype, fd, x = pending
            identity = fd_identities.get((pid, fd)) if fd >= 0 else None
            if identity is None and x:
                identity = path_identities.get((pid, x)) or resolve_path(x)
            fkey = identity_key(x, identity)
            fw = get_file_window(windows[idx], fkey, x, identity, decoy_mgr)
            fw["pids"].add(pid)
            fw["comm_by_pid"][pid] = comm

            if subtype == "RD":
                bytes_read = max(int(fields[6]), 0)
                fw["reads"] = fw.get("reads", 0) + 1
                fw["bytes_read"] = fw.get("bytes_read", 0) + bytes_read
                if is_lab_path(x) and len(fw["read_entropy_samples"]) < 5:
                    ent = known_file_entropy.get(fkey)
                    if ent is None:
                        buf = sample_file_prefix(x)
                        if buf:
                            ent = shannon_entropy_fixed(buf)
                            known_file_entropy[fkey] = ent
                    if ent is not None:
                        fw["read_entropy_samples"].append(ent)
            elif subtype == "W":
                bytes_written = max(int(fields[6]), 0)
                fw["writes"] += 1
                fw["bytes_written"] += bytes_written
                if fw.get("is_decoy") or decoy_mgr.is_decoy(fkey, x):
                    fw["is_decoy"] = True
                    fw["decoy_touched"] = True
                    fw["decoy_operations"] += 1
                if is_lab_path(x) and len(fw["write_entropy_samples"]) < 5:
                    buf = sample_fw_prefix(fw, x)
                    if buf:
                        ent = shannon_entropy_fixed(buf)
                        fw["write_entropy_samples"].append(ent)
                        known_file_entropy[fkey] = ent
            elif subtype == "T":
                fw["truncates"] += 1
                if fw.get("is_decoy") or decoy_mgr.is_decoy(fkey, x):
                    fw["is_decoy"] = True
                    fw["decoy_touched"] = True
                    fw["decoy_operations"] += 1
            elif subtype == "F":
                fw["ftruncates"] += 1
                if fw.get("is_decoy") or decoy_mgr.is_decoy(fkey, x):
                    fw["is_decoy"] = True
                    fw["decoy_touched"] = True
                    fw["decoy_operations"] += 1
            elif subtype == "A":
                fw["fallocates"] += 1
                if fw.get("is_decoy") or decoy_mgr.is_decoy(fkey, x):
                    fw["is_decoy"] = True
                    fw["decoy_touched"] = True
                    fw["decoy_operations"] += 1
            return

        if kind == "O":
            fd = int(fields[5]) if len(fields) >= 7 else None
            x = path_value("\t".join(fields[6:] if fd is not None else fields[5:]))
            identity = resolve_path(x) if x else None
            if identity is None and x:
                identity = path_identities.get((pid, x))
            if fd is not None:
                fd_identities[(pid, fd)] = identity
            if x and identity is not None:
                path_identities[(pid, x)] = identity
            fkey = identity_key(x, identity)
            fw = get_file_window(windows[idx], fkey, x, identity, decoy_mgr)
            fw["pids"].add(pid)
            fw["comm_by_pid"][pid] = comm
            fw["opens"] += 1
            if is_lab_path(x) and fkey not in known_file_entropy:
                buf = sample_file_prefix(x)
                if buf:
                    known_file_entropy[fkey] = shannon_entropy_fixed(buf)

        elif kind == "W":
            fd = int(fields[5]) if len(fields) >= 8 else None
            bytes_written = max(int(fields[6]), 0) if fd is not None else 0
            x = path_value("\t".join(fields[7:] if fd is not None else fields[5:]))
            identity = fd_identities.get((pid, fd)) if fd is not None and fd >= 0 else None
            if identity is None and x:
                identity = path_identities.get((pid, x)) or resolve_path(x)
            fkey = identity_key(x, identity)
            fw = get_file_window(windows[idx], fkey, x, identity, decoy_mgr)
            fw["pids"].add(pid)
            fw["comm_by_pid"][pid] = comm
            fw["writes"] += 1
            fw["bytes_written"] += bytes_written
            if fw.get("is_decoy") or decoy_mgr.is_decoy(fkey, x):
                fw["is_decoy"] = True
                fw["decoy_touched"] = True
                fw["decoy_operations"] += 1
            if is_lab_path(x) and len(fw["write_entropy_samples"]) < 5:
                buf = sample_fw_prefix(fw, x)
                if buf:
                    ent = shannon_entropy_fixed(buf)
                    fw["write_entropy_samples"].append(ent)
                    known_file_entropy[fkey] = ent

        elif kind == "R":
            a = path_value(fields[5])
            b = path_value("\t".join(fields[6:]))
            identity = path_identities.get((pid, a)) if a else None
            if identity is None and b:
                identity = resolve_path(b)
            if identity is None and a:
                identity = resolve_path(a)
            target = b or a
            fkey = identity_key(target, identity)
            fw = get_file_window(windows[idx], fkey, target, identity, decoy_mgr)
            fw["pids"].add(pid)
            fw["comm_by_pid"][pid] = comm
            fw["renames"] += 1
            if a:
                fw["paths"].add(a)
                old_ident = path_identities.pop((pid, a), None)
                old_fkey = identity_key(a, old_ident)
                if old_fkey in known_file_entropy and fkey not in known_file_entropy:
                    known_file_entropy[fkey] = known_file_entropy[old_fkey]
            if b and identity:
                fw["paths"].add(b)
                fw["path"] = b
                path_identities[(pid, b)] = identity
            if fw.get("is_decoy") or decoy_mgr.is_decoy(fkey, target) or (a and decoy_mgr.is_decoy(path=a)):
                fw["is_decoy"] = True
                fw["decoy_touched"] = True
                fw["decoy_operations"] += 1
            if is_lab_path(target) and not fw["write_entropy_samples"]:
                buf = sample_fw_prefix(fw, target)
                if buf:
                    ent = shannon_entropy_fixed(buf)
                    fw["write_entropy_samples"].append(ent)
                    known_file_entropy[fkey] = ent

        elif kind == "D":
            x = path_value("\t".join(fields[5:]))
            identity = path_identities.pop((pid, x), None) if x else None
            if identity is None and x:
                identity = resolve_path(x)
            fkey = identity_key(x, identity)
            fw = get_file_window(windows[idx], fkey, x, identity, decoy_mgr)
            fw["pids"].add(pid)
            fw["comm_by_pid"][pid] = comm
            fw["deletes"] += 1
            if fw.get("is_decoy") or decoy_mgr.is_decoy(fkey, x):
                fw["is_decoy"] = True
                fw["decoy_touched"] = True
                fw["decoy_operations"] += 1

        elif kind in ("T", "F", "A"):
            fd = int(fields[5]) if kind in ("F", "A") and len(fields) >= 7 else None
            x = path_value("\t".join(fields[6:] if fd is not None else fields[5:]))
            identity = fd_identities.get((pid, fd)) if fd is not None else None
            if identity is None:
                identity = path_identities.get((pid, x)) if x else None
            if identity is None and x:
                identity = resolve_path(x)
            fkey = identity_key(x, identity)
            fw = get_file_window(windows[idx], fkey, x, identity, decoy_mgr)
            fw["pids"].add(pid)
            fw["comm_by_pid"][pid] = comm
            if fw.get("is_decoy") or decoy_mgr.is_decoy(fkey, x):
                fw["is_decoy"] = True
                fw["decoy_touched"] = True
                fw["decoy_operations"] += 1
            if kind == "T":
                fw["truncates"] += 1
            elif kind == "F":
                fw["ftruncates"] += 1
            else:
                fw["fallocates"] += 1

    try:
        while not ready:
            line_text = proc.stdout.readline()
            if line_text:
                handle(line_text)
            elif proc.poll() is not None:
                raise RuntimeError("bpftrace exited before READY")
        print(f"{CYAN}eBPF LSM Shield live monitor | tracepoints=LIVE | identity=FILE-CENTRIC | scoring=PROTOTYPE{RESET}")
        print(f"{CYAN}Decoy/Canary Honeypot: {len(decoy_mgr.deployed_files)} canaries deployed in /tmp/ebpf_shield_canaries{RESET}")
        print(f"{DIM}Waiting for filesystem activity... Ctrl-C to stop.{RESET}")
        sys.stdout.flush()
        for line_text in proc.stdout:
            handle(line_text)
    except KeyboardInterrupt:
        pass
    finally:
        decoy_mgr.cleanup()
        proc.send_signal(signal.SIGINT)
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()


